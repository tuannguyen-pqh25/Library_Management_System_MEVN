PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/QuanLyMuonSach
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=1d
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
GEMINI_API_KEY=your_gemini_api_key
# Nhiều key (tùy chọn): tự động xoay vòng khi key bị rate limit
# GEMINI_API_KEYS=key1,key2,key3
# Model fallback chain: khi model chính bị 503, tự động chuyển xuống model nhẹ hơn
# GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.5-flash-lite
# Retry config (exponential backoff)
# GEMINI_MAX_RETRIES=3
# GEMINI_INITIAL_DELAY_MS=1000
# GEMINI_MAX_DELAY_MS=15000

